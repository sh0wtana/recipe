<div class="grid gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>

  <%= link_to t(".new_tag"), new_tag_path, class: "btn btn-primary btn-block" %>

  <%= search_form_for @q, url: tags_path do |form| %>
    <%= form.label Tag::SEARCH_PARAM, t(".search"), class: "sr-only" %>

    <div class="join w-full">
      <%= form.search_field Tag::SEARCH_PARAM, placeholder: t(".search"),
            class: "input join-item w-full bg-base-100" %>
      <%= form.submit t(".search_submit"), class: "btn btn-primary join-item" %>
    </div>
  <% end %>

  <% if @search_term.present? %>
    <%= link_to t(".clear_search"), tags_path, id: "clear-search",
          class: "btn btn-ghost btn-sm justify-self-start" %>
  <% end %>

  <% if @tags.any? %>
    <ul id="tags" class="grid gap-2">
      <% @tags.each do |tag| %>
        <li id="<%= dom_id(tag) %>" class="card flex-row items-center gap-3 bg-base-100 p-3 shadow-sm">
          <%= link_to tag.name, edit_tag_path(tag), class: "min-w-0 flex-1 truncate font-medium" %>
          <span class="recipes-count shrink-0 text-sm opacity-70"><%= t(".recipes_count", count: tag.recipes.size) %></span>

          <%# Deleting takes the tag off every recipe that had it, and there is
              no undo, so the confirmation says how many that is. %>
          <%= button_to t(".destroy"), tag, method: :delete, class: "btn btn-ghost btn-sm shrink-0 text-error",
                form: { data: { turbo_confirm: t(".confirm_destroy", name: tag.name, count: tag.recipes.size) } } %>
        </li>
      <% end %>
    </ul>

    <%== @pagy.series_nav %>
  <%# "No tags" would be a lie when a search simply found nothing. %>
  <% elsif @search_term.present? %>
    <p class="py-8 text-center opacity-70"><%= t(".no_results") %></p>
  <% else %>
    <p class="py-8 text-center opacity-70"><%= t(".empty") %></p>
  <% end %>

  <%= link_to t(".back"), recipes_path, class: "btn btn-ghost" %>
</div>
