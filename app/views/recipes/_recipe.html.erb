<%# isolate keeps these z-indexes off the fixed dock. The overlay needs z-10 to
    clear <time>, whose opacity paints it alongside positioned elements. %>
<li class="card relative isolate bg-base-100 shadow-sm">
  <%= link_to recipe.title, recipe,
        class: "block px-4 pt-4 text-lg font-semibold leading-snug after:absolute after:inset-0 after:z-10" %>

  <% if recipe.tags.any? %>
    <ul class="flex flex-wrap gap-1.5 px-4 pt-2">
      <% recipe.tags.each do |tag| %>
        <li>
          <%= link_to tag.name, recipes_path(q: { Recipe::SEARCH_PARAM => tag.name }),
                class: "badge badge-secondary badge-sm relative z-20" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <time class="px-4 pb-4 pt-2 text-sm opacity-70" datetime="<%= recipe.created_at.iso8601 %>"><%= l(recipe.created_at, format: :long) %></time>
</li>
