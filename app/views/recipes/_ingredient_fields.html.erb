<div data-nested-rows-target="row" class="flex items-center gap-2">
  <%# 2:1, the split Cookpad uses. min-w-0 lets both shrink past their content. %>
  <%= form.text_field :name, class: "input input-sm min-w-0 flex-[2]",
        placeholder: Ingredient.human_attribute_name(:name),
        "aria-label": Ingredient.human_attribute_name(:name) %>
  <%= form.text_field :amount, class: "input input-sm min-w-0 flex-1",
        placeholder: Ingredient.human_attribute_name(:amount),
        "aria-label": Ingredient.human_attribute_name(:amount) %>
  <%= form.hidden_field :position, data: { position: "" } %>
  <%= form.hidden_field :_destroy, data: { destroy: "" } %>
  <button type="button" data-action="nested-rows#remove" class="btn btn-ghost btn-xs shrink-0 text-error"><%= t(".remove") %></button>
</div>
