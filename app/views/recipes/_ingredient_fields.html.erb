<div data-nested-rows-target="row">
  <%= form.text_field :name %>
  <%= form.text_field :amount %>
  <%= form.hidden_field :position, data: { position: "" } %>
  <%= form.hidden_field :_destroy, data: { destroy: "" } %>
  <button type="button" data-action="nested-rows#remove"><%= t(".remove") %></button>
</div>
