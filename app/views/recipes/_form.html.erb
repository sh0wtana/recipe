<%= form_with model: recipe,
      data: { controller: "submit-guard", action: "keydown->submit-guard#guard" },
      class: "grid gap-5" do |form| %>
  <% if recipe.errors.any? %>
    <div id="error_explanation" class="alert alert-error">
      <ul class="list-disc pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The label covers the whole tile so it is one big tap target, which is what
      one-handed use in a kitchen needs. The 🗑 button has to stay outside the
      label — a click inside a label is forwarded to the input it wraps, so a
      button in there would open the photo picker instead of deleting. %>
  <div class="card relative isolate aspect-[4/3] overflow-hidden bg-base-200 shadow-sm"
       data-controller="photo-preview">
    <% image_classes = "absolute inset-0 h-full w-full object-cover" %>

    <% show_photo = recipe.photo.attached? && recipe.photo.blob.persisted? %>

    <label class="absolute inset-0 grid cursor-pointer place-items-center">
      <%# No capture attribute. It opens the camera directly and takes the
          camera roll out of the choice, which is the whole point of the field. %>
      <%= form.file_field :photo,
            accept: "image/jpeg,image/png,image/webp,image/heic,image/heif",
            class: "sr-only",
            data: { photo_preview_target: "input", action: "photo-preview#show" } %>

      <%# Doubles as the fallback readout when the browser cannot draw the pick. %>
      <span class="px-4 text-center text-sm opacity-70" data-photo-preview-target="label"><%= t(".choose_photo") %></span>

      <%# alt is empty on purpose. The title field sits right below, and the
          picture carries nothing a screen reader can use. %>
      <% if show_photo %>
        <%= image_tag recipe.photo.variant(:large), alt: "", class: image_classes,
              data: { photo_preview_target: "image", action: "error->photo-preview#failed" } %>
      <% else %>
        <img alt="" class="<%= image_classes %> hidden" data-photo-preview-target="image"
             data-action="error->photo-preview#failed">
      <% end %>
    </label>

    <%= form.hidden_field :remove_photo, value: "", data: { photo_preview_target: "flag" } %>

    <button type="button"
            class="btn btn-circle btn-sm absolute right-2 top-2 z-10 <%= "hidden" unless show_photo %>"
            aria-label="<%= t(".remove_photo") %>"
            data-photo-preview-target="button"
            data-action="photo-preview#remove">🗑</button>
  </div>

  <div class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <div class="grid gap-1">
      <div class="flex items-baseline justify-between">
        <%= form.label :title, class: "text-sm font-medium" %>
        <span class="max-length-hint text-xs opacity-70"><%= t("shared.forms.max_length_hint", count: 20) %></span>
      </div>
      <%= form.text_field :title, maxlength: 20, class: "input w-full" %>
    </div>

    <div class="grid gap-1">
      <div class="flex items-baseline justify-between">
        <%= form.label :description, class: "text-sm font-medium" %>
        <span class="max-length-hint text-xs opacity-70"><%= t("shared.forms.max_length_hint", count: 320) %></span>
      </div>
      <%= form.text_area :description, rows: 3, maxlength: 320, class: "textarea w-full" %>
    </div>

    <div class="grid gap-1">
      <div class="flex items-baseline justify-between">
        <%= form.label :servings, class: "text-sm font-medium" %>
        <span class="max-length-hint text-xs opacity-70"><%= t("shared.forms.max_length_hint", count: 25) %></span>
      </div>
      <%= form.text_field :servings, maxlength: 25, class: "input w-full" %>
    </div>
  </div>

  <fieldset id="tag-fields" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:tags) %></legend>

    <div class="flex flex-wrap gap-x-4 gap-y-2">
      <% tag_choices(recipe).each_with_index do |name, index| %>
        <div class="flex items-center gap-2">
          <%= check_box_tag "recipe[tag_names][]", name,
                recipe.tag_names.include?(name), id: "tag-#{index}", class: "checkbox checkbox-sm" %>
          <%= label_tag "tag-#{index}", name, class: "cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# Submits even when empty, which is the only reason unticking every box
        arrives as a deliberate clear rather than as no tag_names at all. %>
    <div class="grid gap-1">
      <div class="flex items-baseline justify-between">
        <%= label_tag "new-tag", t(".new_tag"), class: "text-sm font-medium" %>
        <span class="max-length-hint text-xs opacity-70"><%= t("shared.forms.max_length_hint", count: 20) %></span>
      </div>
      <%= text_field_tag "recipe[tag_names][]", nil, id: "new-tag", maxlength: 20, class: "input w-full" %>
    </div>
  </fieldset>

  <fieldset id="ingredient-fields" data-controller="nested-rows" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:ingredients) %></legend>

    <div data-nested-rows-target="list" class="grid gap-2">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add" class="btn btn-ghost btn-sm justify-self-start"><%= t(".add_ingredient") %></button>
  </fieldset>

  <fieldset id="step-fields" data-controller="nested-rows" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:steps) %></legend>

    <div data-nested-rows-target="list" class="grid gap-2">
      <%= form.fields_for :steps do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :steps, Step.new, child_index: "NEW_RECORD" do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add" class="btn btn-ghost btn-sm justify-self-start"><%= t(".add_step") %></button>
  </fieldset>

  <div class="card grid gap-1 bg-base-100 p-4 shadow-sm">
    <div class="flex items-baseline justify-between">
      <%= form.label :tips, class: "text-sm font-medium" %>
      <span class="max-length-hint text-xs opacity-70"><%= t("shared.forms.max_length_hint", count: 120) %></span>
    </div>
    <%= form.text_area :tips, rows: 3, maxlength: 120, class: "textarea w-full" %>
  </div>

  <%= form.submit class: "btn btn-primary btn-block" %>
<% end %>
