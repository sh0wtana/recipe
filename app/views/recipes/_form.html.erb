<%# #13 adds the tag chips. Deliberately no tag_names field yet: an empty
    array clears every tag, so the sentinel arrives with the chip UI. %>
<%= form_with model: recipe do |form| %>
  <% if recipe.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :servings %>
    <%= form.text_field :servings %>
  </div>

  <fieldset id="ingredient-fields" data-controller="nested-rows">
    <legend><%= Recipe.human_attribute_name(:ingredients) %></legend>

    <div data-nested-rows-target="list">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add"><%= t(".add_ingredient") %></button>
  </fieldset>

  <fieldset id="step-fields" data-controller="nested-rows">
    <legend><%= Recipe.human_attribute_name(:steps) %></legend>

    <div data-nested-rows-target="list">
      <%= form.fields_for :steps do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :steps, Step.new, child_index: "NEW_RECORD" do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add"><%= t(".add_step") %></button>
  </fieldset>

  <div>
    <%= form.label :tips %>
    <%= form.text_area :tips %>
  </div>

  <%= form.submit %>
<% end %>
