<%= form_with model: recipe, class: "grid gap-5" do |form| %>
  <% if recipe.errors.any? %>
    <div id="error_explanation" class="alert alert-error">
      <ul class="list-disc pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <div class="grid gap-1">
      <%= form.label :title, class: "text-sm font-medium" %>
      <%= form.text_field :title, class: "input w-full" %>
    </div>

    <div class="grid gap-1">
      <%= form.label :description, class: "text-sm font-medium" %>
      <%= form.text_area :description, rows: 3, class: "textarea w-full" %>
    </div>

    <div class="grid gap-1">
      <%= form.label :servings, class: "text-sm font-medium" %>
      <%= form.text_field :servings, class: "input w-full" %>
    </div>
  </div>

  <fieldset id="tag-fields" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:tags) %></legend>

    <div class="flex flex-wrap gap-x-4 gap-y-2">
      <% tag_choices(recipe).each_with_index do |name, index| %>
        <div class="flex items-center gap-2">
          <%= check_box_tag "recipe[tag_names][]", name,
                recipe.tag_names.include?(name), id: "tag-#{index}", class: "checkbox checkbox-sm" %>
          <%= label_tag "tag-#{index}", name, class: "cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# Submits even when empty, which is the only reason unticking every box
        arrives as a deliberate clear rather than as no tag_names at all. %>
    <div class="grid gap-1">
      <%= label_tag "new-tag", t(".new_tag"), class: "text-sm font-medium" %>
      <%= text_field_tag "recipe[tag_names][]", nil, id: "new-tag", class: "input w-full" %>
    </div>
  </fieldset>

  <fieldset id="ingredient-fields" data-controller="nested-rows" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:ingredients) %></legend>

    <div data-nested-rows-target="list" class="grid gap-2">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add" class="btn btn-ghost btn-sm justify-self-start"><%= t(".add_ingredient") %></button>
  </fieldset>

  <fieldset id="step-fields" data-controller="nested-rows" class="card grid gap-3 bg-base-100 p-4 shadow-sm">
    <legend class="mb-2 text-lg font-semibold"><%= Recipe.human_attribute_name(:steps) %></legend>

    <div data-nested-rows-target="list" class="grid gap-2">
      <%= form.fields_for :steps do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </div>

    <%# Inert: a hidden div would submit its fields on every save. %>
    <template data-nested-rows-target="template">
      <%= form.fields_for :steps, Step.new, child_index: "NEW_RECORD" do |step_form| %>
        <%= render "step_fields", form: step_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-rows#add" class="btn btn-ghost btn-sm justify-self-start"><%= t(".add_step") %></button>
  </fieldset>

  <div class="card grid gap-1 bg-base-100 p-4 shadow-sm">
    <%= form.label :tips, class: "text-sm font-medium" %>
    <%= form.text_area :tips, rows: 3, class: "textarea w-full" %>
  </div>

  <%= form.submit class: "btn btn-primary btn-block" %>
<% end %>
