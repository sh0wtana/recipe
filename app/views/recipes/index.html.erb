<div>
  <h1><%= t(".title") %></h1>

  <% if @recipes.any? %>
    <ul id="recipes">
      <% @recipes.each do |recipe| %>
        <li>
          <%= link_to recipe.title, recipe %>

          <% if recipe.tags.any? %>
            <ul>
              <% recipe.tags.each do |tag| %>
                <li><%= link_to tag.name, recipes_path(tag: tag.name) %></li>
              <% end %>
            </ul>
          <% end %>

          <time datetime="<%= recipe.created_at.iso8601 %>">
            <%= l(recipe.created_at, format: :long) %>
          </time>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p><%= t(".empty") %></p>
  <% end %>
</div>
