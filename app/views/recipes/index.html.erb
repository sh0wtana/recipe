<div>
  <h1><%= t(".title") %></h1>

  <%= search_form_for @q, url: recipes_path do |form| %>
    <%= form.label Recipe::SEARCH_PARAM, t(".search") %>
    <%= form.search_field Recipe::SEARCH_PARAM %>
    <%= form.submit t(".search_submit") %>
  <% end %>

  <% if @search_term.present? %>
    <%= link_to t(".clear_search"), recipes_path, id: "clear-search" %>
  <% end %>

  <% if @recipes.any? %>
    <ul id="recipes">
      <% @recipes.each do |recipe| %>
        <li>
          <%= link_to recipe.title, recipe %>

          <% if recipe.tags.any? %>
            <ul>
              <% recipe.tags.each do |tag| %>
                <li><%= link_to tag.name, recipes_path(q: { Recipe::SEARCH_PARAM => tag.name }) %></li>
              <% end %>
            </ul>
          <% end %>

          <time datetime="<%= recipe.created_at.iso8601 %>">
            <%= l(recipe.created_at, format: :long) %>
          </time>
        </li>
      <% end %>
    </ul>

    <%== @pagy.series_nav %>
  <%# "No recipes" would be a lie when a search simply found nothing. %>
  <% elsif @search_term.present? %>
    <p><%= t(".no_results") %></p>
  <% else %>
    <p><%= t(".empty") %></p>
  <% end %>
</div>
